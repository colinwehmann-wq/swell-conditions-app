<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.swellconditions</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/path/to/Swell Conditions App/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/Swell Conditions App</string>

    <!-- Local clock times. Fires at each; if the Mac was asleep, it runs on wake. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>5</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>10</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/path/to/Swell Conditions App/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/Swell Conditions App/logs/launchd.log</string>
</dict>
</plist>
